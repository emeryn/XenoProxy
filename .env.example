# XenoProxy configuration reference.
#
# The stack starts without this file: `docker compose up -d` generates every
# secret into a named volume. Copy this file to `.env` only to override a
# default, and never commit the result.
#
# Secrets are read from files in production. Each *_FILE variable points at a
# file mounted into the container; the plain variant exists for local runs only.

# --- Runtime -----------------------------------------------------------------
BACKEND_ENVIRONMENT=production
BACKEND_LOG_LEVEL=INFO
BACKEND_PUBLIC_URL=http://localhost:8099
# The OpenAPI UI is disabled in production; set to true only on a dev instance.
BACKEND_DOCS_ENABLED=false

# --- Database ----------------------------------------------------------------
BACKEND_DB_HOST=database
BACKEND_DB_PORT=5432
BACKEND_DB_NAME=xenoproxy
BACKEND_DB_USER=xenoproxy_app
BACKEND_DB_PASSWORD_FILE=/run/secrets/db_password

# --- Task queue --------------------------------------------------------------
BACKEND_REDIS_HOST=queue
BACKEND_REDIS_PORT=6379
BACKEND_REDIS_DB=0

# --- Cryptography ------------------------------------------------------------
# secret_key signs cookies; master_key wraps every plugin credential.
# Rotating master_key makes the stored credentials unreadable: re-enter them.
BACKEND_SECRET_KEY_FILE=/run/secrets/secret_key
BACKEND_MASTER_KEY_FILE=/run/secrets/master_key

# --- Sessions ----------------------------------------------------------------
BACKEND_SESSION_IDLE_MINUTES=60
BACKEND_SESSION_ABSOLUTE_HOURS=12

# --- First administrator -----------------------------------------------------
# Read by docker-compose.yml, which passes them to the API. Leave the password
# unset to have one generated into the secrets volume on first boot, then read
# it with: docker compose run --rm api admin-password
XENOPROXY_ADMIN_USERNAME=admin
# XENOPROXY_ADMIN_PASSWORD=choose-your-own-at-least-12-characters
# In production, take the password from the secrets provider instead:
# BACKEND_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# --- Two-factor policy -------------------------------------------------------
# Both are editable in Admin > Settings > Security when left unset. Give one a
# value to pin it: the interface then shows it read-only and refuses a change.
# This is the way out of the chicken-and-egg, because an account that still owes
# an enrolment cannot reach the settings page to turn the requirement off.
# BACKEND_REQUIRE_MFA_FOR_ADMINS=false
# BACKEND_REQUIRE_MFA_FOR_ALL=false

# --- Reverse proxy and client address ----------------------------------------
# Number of trusted proxies in front of the API. Set it correctly or the client
# IP in the audit trail and the rate limits can be spoofed.
BACKEND_TRUSTED_PROXY_COUNT=1

# --- Single sign-on: identity delegated by the reverse proxy ------------------
# BACKEND_PROXY_AUTH_ENABLED=false
# BACKEND_PROXY_AUTH_USER_HEADER=X-Remote-User
# BACKEND_PROXY_AUTH_EMAIL_HEADER=X-Remote-Email
# BACKEND_PROXY_AUTH_GROUPS_HEADER=X-Remote-Groups

# --- Single sign-on: OIDC ----------------------------------------------------
# Anything set here wins over the Admin UI and is shown there as read-only.
# BACKEND_OIDC_ENABLED=false
# BACKEND_OIDC_ISSUER=https://sso.example.com/realms/main
# BACKEND_OIDC_CLIENT_ID=xenoproxy
# BACKEND_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# BACKEND_OIDC_SCOPES=openid profile email groups
# BACKEND_OIDC_ADMIN_GROUP=xenoproxy-admins

# --- Plugin execution --------------------------------------------------------
BACKEND_CACHE_DEFAULT_TTL_SECONDS=86400
BACKEND_ANALYZER_DEFAULT_TIMEOUT_SECONDS=60
BACKEND_ANALYZER_MAX_CONCURRENCY=8
# Scanning loopback and RFC1918 targets stays off unless an internal plugin
# genuinely needs it. Enabling it widens the SSRF surface.
BACKEND_ALLOW_PRIVATE_TARGETS=false

# --- Outbound network --------------------------------------------------------
# BACKEND_OUTBOUND_PROXY_URL=http://proxy.internal:3128
# BACKEND_CUSTOM_CA_FILE=/etc/ssl/internal/ca-bundle.crt

# --- Request limits ----------------------------------------------------------
BACKEND_MAX_BODY_BYTES=2097152
BACKEND_MAX_UPLOAD_BYTES=33554432
BACKEND_MAX_PAGE_SIZE=100

# --- Browser origins ---------------------------------------------------------
# Only needed when the frontend is served from another origin than the API.
# BACKEND_CORS_ORIGINS=https://xenoproxy.example.com

# Plugin API keys (Shodan, Censys, VirusTotal, ...) are NOT configured here.
# An administrator enters them in the web interface, Admin > Plugins & keys,
# and they are stored encrypted in the database.
