    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.19.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "4.7.0",
